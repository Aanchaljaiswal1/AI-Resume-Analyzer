# Gemini AI Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL:
# For SQLite (zero configuration default):
# DATABASE_URL=sqlite:///./resumes.db
# For PostgreSQL (e.g., Supabase / Neon / Render Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# For MySQL (e.g., Aiven / TiDB / local):
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname
